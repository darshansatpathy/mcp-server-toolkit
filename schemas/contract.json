          "idempotency_key": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 8,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Idempotency Key"
          },
          "priority": {
            "default": "normal",
