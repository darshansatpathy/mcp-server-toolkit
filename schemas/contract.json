        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Open a ticket. Pass an idempotency_key when retrying so a retry cannot create a duplicate.",
      "inputSchema": {
        "properties": {
          "body": {
            "maxLength": 5000,
            "title": "Body",
            "type": "string"
